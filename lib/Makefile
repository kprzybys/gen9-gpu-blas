# libgen9blas: BLAS (levels 1–3) on the UHD 620. Default is without NEO: kcl (an OpenCL subset on i915) + built-in kernels
# (kernels.c generated by gen_kernels.py from ../bench/*.cl and the asm binaries ../bench/gen_*.bin; needs ocloc to build).
# libgen9blas_neo.so / libgen9blas_blas_neo.so: the old path through NEO (OpenCL), for comparisons only.
GEN = third_party/mesa
CFL = -O2 -Wall -shared -fPIC
CL_SOURCES = ../bench/hgemm.cl ../bench/sgemm.cl ../bench/dgemm.cl ../bench/level12.cl ../bench/gen_h.bin ../bench/gen_hd.bin ../bench/gen_s.bin
all: libgen9blas.so libgen9blas_blas.so libgen9blas_neo.so libgen9blas_blas_neo.so

kernels.c: gen_kernels.py $(CL_SOURCES)
	python3 gen_kernels.py ../bench .kernels > $@

# Gen8 (Cherryview, compiled as Broadwell; docs/gen8.md): the .cl programs only, patch-token format
kernels_gen8.c: gen_kernels.py $(filter %.cl,$(CL_SOURCES))
	python3 gen_kernels.py ../bench .kernels_gen8 bdw > $@

# Check of the patch-token reader against zebin on Gen9.5 (needs ocloc, no GPU)
check-patchtokens:
	python3 check_patchtokens.py .check_patchtokens

KCL_SRC = kcl.c kcl_gen8.c kernels.c kernels_gen8.c
KCL_DEP = $(KCL_SRC) kcl.h kcl_desc.h kcl_gen8.h $(GEN)/gen9_pack.h $(GEN)/gen8_pack.h

# Gen8 bring-up probe (bench/gen8_probe.cl through kcl, docs/gen8.md 6a): its own Gen8 table with the probe program
kernels_gen8_probe.c: gen_kernels.py $(filter %.cl,$(CL_SOURCES)) ../bench/gen8_probe.cl
	python3 gen_kernels.py ../bench .kernels_gen8_probe bdw-probe > $@
bench_gen8: bench_gen8.c kcl.c kcl_gen8.c kernels.c kernels_gen8_probe.c kcl.h kcl_desc.h kcl_gen8.h $(GEN)/gen9_pack.h $(GEN)/gen8_pack.h
	gcc -O2 -Wall -I$(GEN) -o $@ bench_gen8.c kcl.c kcl_gen8.c kernels.c kernels_gen8_probe.c -lm
test_gen8_probe: test_gen8_probe.c kcl.c kcl_gen8.c kernels.c kernels_gen8_probe.c kcl.h kcl_desc.h kcl_gen8.h $(GEN)/gen9_pack.h $(GEN)/gen8_pack.h
	gcc -O2 -Wall -I$(GEN) -o $@ test_gen8_probe.c kcl.c kcl_gen8.c kernels.c kernels_gen8_probe.c -lm

libgen9blas.so: gen9blas.c gen9blas.h $(KCL_DEP)
	gcc $(CFL) -I$(GEN) -o $@ gen9blas.c $(KCL_SRC) -lm

libgen9blas_neo.so: gen9blas.c gen9blas.h
	gcc $(CFL) -DGEN9BLAS_NEO -o $@ gen9blas.c -lOpenCL -lm

test: libgen9blas.so
	python3 test_basic.py

# Builds and runs all 10 test suites in sequence; stops on the first failure.
check: libgen9blas.so libgen9blas_blas.so
	python3 test_basic.py
	python3 test_level3.py
	python3 test_level12.py
	python3 test_userptr.py
	python3 test_skinny.py
	python3 test_blas.py
	python3 test_blas_d.py
	python3 test_blas_banded.py
	GEN9BLAS_MAX_LAUNCH_MS=0.5 python3 test_level3.py
	python3 test_long_launch.py

clean:
	rm -f libgen9blas.so libgen9blas_neo.so libgen9blas_blas.so libgen9blas_blas_neo.so kernels.c kernels_gen8.c kernels_gen8_probe.c test_gen8_probe bench_gen8

# Full BLAS/CBLAS: S/D functions on the GPU, the rest through jumps to OpenBLAS (gen9blas_blas_forward.c generated from the symbol list).
libgen9blas_blas.so: gen9blas.c gen9blas.h $(KCL_DEP) gen9blas_blas.c gen9blas_blas_d.inc gen9blas_blas_forward.c
	gcc $(CFL) -I$(GEN) -o $@ gen9blas.c $(KCL_SRC) gen9blas_blas.c gen9blas_blas_forward.c -lm -ldl -lpthread

libgen9blas_blas_neo.so: gen9blas.c gen9blas.h gen9blas_blas.c gen9blas_blas_d.inc gen9blas_blas_forward.c
	gcc $(CFL) -DGEN9BLAS_NEO -o $@ gen9blas.c gen9blas_blas.c gen9blas_blas_forward.c -lOpenCL -lm -ldl -lpthread

gen9blas_blas_forward.c: gen_forward.py blas_symbols.txt gen9blas_blas.c gen9blas_blas_d.inc
	python3 gen_forward.py blas_symbols.txt gen9blas_blas.c gen9blas_blas_d.inc > $@

# D functions of the BLAS layer from the S function code (float -> double, names s -> d).
gen9blas_blas_d.inc: gen_blas_d.py gen9blas_blas.c
	python3 gen_blas_d.py gen9blas_blas.c > $@

# Level-3 FP64 kernels: core (packing, DGEMM) + helper kernels from sgemm.cl after type substitution.
../bench/dgemm.cl: gen_dgemm.py ../bench/sgemm.cl ../bench/dgemm_core.cl
	python3 gen_dgemm.py ../bench/sgemm.cl ../bench/dgemm_core.cl > $@
