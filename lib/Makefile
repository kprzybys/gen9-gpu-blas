# libgen9blas: BLAS (levels 1–3) on the UHD 620. Default is without NEO: kcl (an OpenCL subset on i915) + built-in kernels
# (kernels.c generated by gen_kernels.py from kernels/*.cl and the asm binaries kernels/gen_*.bin; needs ocloc to build).
# libgen9blas_neo.so / libgen9blas_blas_neo.so: the old path through NEO (OpenCL), for comparisons only.
GEN = third_party/mesa
CFL = -O2 -Wall -shared -fPIC
CL_SOURCES = kernels/hgemm.cl kernels/sgemm.cl kernels/dgemm.cl kernels/level12.cl kernels/gen_h.bin kernels/gen_hd.bin kernels/gen_s.bin
# attention (src/attn.c): the *_tokc binaries of `make -C ../asm attn` (whl), embedded when present
CL_SOURCES += $(wildcard kernels/attn_qwen_tokc.bin kernels/attn_llama_tokc.bin kernels/attn_whisper_tokc.bin kernels/attn_qwen7b_tokc.bin kernels/attn_qwen3_tokc.bin kernels/attn_nemo_tokc.bin kernels/attn_paddle_tokc.bin kernels/attn_ernie_tokc.bin kernels/attn_ernie_stokc.bin)
all: libgen9blas.so libgen9blas_blas.so libgen9blas_neo.so libgen9blas_blas_neo.so

kernels.c: gen_kernels.py $(CL_SOURCES)
	python3 gen_kernels.py kernels .kernels > $@

# Gen8 (Cherryview, compiled as Broadwell; docs/gen8.md): the .cl programs only, patch-token format
kernels_gen8.c: gen_kernels.py $(filter %.cl,$(CL_SOURCES))
	python3 gen_kernels.py kernels .kernels_gen8 bdw > $@

# Check of the patch-token reader against zebin on Gen9.5 (needs ocloc, no GPU)
check-patchtokens:
	python3 check_patchtokens.py .check_patchtokens

KCL_SRC = kcl.c kcl_gen8.c kernels.c kernels_gen8.c
KCL_DEP = $(KCL_SRC) kcl.h kcl_desc.h kcl_gen8.h $(GEN)/gen9_pack.h $(GEN)/gen8_pack.h

# Gen8 bring-up probe (lib/kernels/gen8_probe.cl through kcl, docs/gen8.md 6a): its own Gen8 table with the probe program
kernels_gen8_probe.c: gen_kernels.py $(filter %.cl,$(CL_SOURCES)) kernels/gen8_probe.cl
	python3 gen_kernels.py kernels .kernels_gen8_probe bdw-probe > $@
bench_gen8: bench_gen8.c kcl.c kcl_gen8.c kernels.c kernels_gen8_probe.c kcl.h kcl_desc.h kcl_gen8.h $(GEN)/gen9_pack.h $(GEN)/gen8_pack.h
	gcc -O2 -Wall -I$(GEN) -o $@ bench_gen8.c kcl.c kcl_gen8.c kernels.c kernels_gen8_probe.c -lm
test_gen8_probe: test_gen8_probe.c kcl.c kcl_gen8.c kernels.c kernels_gen8_probe.c kcl.h kcl_desc.h kcl_gen8.h $(GEN)/gen9_pack.h $(GEN)/gen8_pack.h
	gcc -O2 -Wall -I$(GEN) -o $@ test_gen8_probe.c kcl.c kcl_gen8.c kernels.c kernels_gen8_probe.c -lm

# libkcl.a: kcl for programs with their own kernel table (apps, bench): one build of kcl.c, symbols hidden, so every
# shared object linking it keeps its own instance (as when each compiled kcl.c itself; refactor 2c)
libkcl.a: kcl.c kcl.h kcl_desc.h $(GEN)/gen9_pack.h
	mkdir -p .kcl && gcc -O2 -Wall -fPIC -fvisibility=hidden -I$(GEN) -c kcl.c -o .kcl/kcl.o && ar rcs $@ .kcl/kcl.o

# library units (refactor 2b: lib/gen9blas.c split into src/, shared state in src/internal.h)
LIB_SRC = src/core.c src/gemm.c src/packed.c src/ops.c src/level3.c src/level12.c
LIB_DEP = $(LIB_SRC) src/internal.h gen9blas.h
libgen9blas.so: $(LIB_DEP) $(KCL_DEP) src/attn.c
	gcc $(CFL) -I. -I$(GEN) -o $@ $(LIB_SRC) $(KCL_SRC) src/attn.c -lm

libgen9blas_neo.so: $(LIB_DEP)
	gcc $(CFL) -I. -DGEN9BLAS_NEO -o $@ $(LIB_SRC) -lOpenCL -lm

test: libgen9blas.so
	python3 test_basic.py

# Builds and runs all 10 test suites in sequence; stops on the first failure.
check: libgen9blas.so libgen9blas_blas.so
	python3 test_basic.py
	python3 test_level3.py
	python3 test_level12.py
	python3 test_userptr.py
	python3 test_skinny.py
	python3 test_blas.py
	python3 test_blas_d.py
	python3 test_blas_banded.py
	GEN9BLAS_MAX_LAUNCH_MS=0.5 python3 test_level3.py
	python3 test_long_launch.py
	python3 test_packed.py
	GEN9BLAS_PACK_BAND_MB=1 SKIP_BIG=1 python3 test_packed.py

clean:
	rm -rf .kcl libkcl.a; rm -f libgen9blas.so libgen9blas_neo.so libgen9blas_blas.so libgen9blas_blas_neo.so kernels.c kernels_gen8.c kernels_gen8_probe.c test_gen8_probe bench_gen8

# Full BLAS/CBLAS: S/D functions on the GPU, the rest through jumps to OpenBLAS (src/cblas_forward.c generated from the symbol list).
libgen9blas_blas.so: $(LIB_DEP) $(KCL_DEP) src/cblas.c src/cblas_d.inc src/cblas_forward.c
	gcc $(CFL) -I. -I$(GEN) -o $@ $(LIB_SRC) $(KCL_SRC) src/cblas.c src/cblas_forward.c -lm -ldl -lpthread

libgen9blas_blas_neo.so: $(LIB_DEP) src/cblas.c src/cblas_d.inc src/cblas_forward.c
	gcc $(CFL) -I. -DGEN9BLAS_NEO -o $@ $(LIB_SRC) src/cblas.c src/cblas_forward.c -lOpenCL -lm -ldl -lpthread

src/cblas_forward.c: gen_forward.py blas_symbols.txt src/cblas.c src/cblas_d.inc
	python3 gen_forward.py blas_symbols.txt src/cblas.c src/cblas_d.inc > $@

# D functions of the BLAS layer from the S function code (float -> double, names s -> d).
src/cblas_d.inc: gen_blas_d.py src/cblas.c
	python3 gen_blas_d.py src/cblas.c > $@

# Level-3 FP64 kernels: core (packing, DGEMM) + helper kernels from sgemm.cl after type substitution.
kernels/dgemm.cl: gen_dgemm.py kernels/sgemm.cl kernels/dgemm_core.cl
	python3 gen_dgemm.py kernels/sgemm.cl kernels/dgemm_core.cl > $@
