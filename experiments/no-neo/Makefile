# Experiments without NEO (description: ../../docs/no-neo.md).
# The Gen9 command header (../../lib/third_party/mesa/gen9_pack.h) is tracked and shared with lib/; it is NOT
# regenerated by `make` or `make all`. To regenerate it from Mesa genxml explicitly, run `make gen9_pack`.
GENXML = ../../third_party/mesa-25.2.8/genxml
SYMBOLS = PIPELINE_SELECT,STATE_BASE_ADDRESS,MEDIA_VFE_STATE,MEDIA_INTERFACE_DESCRIPTOR_LOAD,INTERFACE_DESCRIPTOR_DATA,GPGPU_WALKER,MEDIA_STATE_FLUSH,PIPE_CONTROL,MI_BATCH_BUFFER_END,MI_LOAD_REGISTER_IMM,MI_STORE_REGISTER_MEM,MI_NOOP,MEMORY_OBJECT_CONTROL_STATE,L3CNTLREG,RENDER_SURFACE_STATE,BINDING_TABLE_STATE
GEN9_PACK = ../../lib/third_party/mesa/gen9_pack.h
all: first neo_compare probe store.isa chain neo_chain chain_bti gemm_h userptr
.PHONY: all gen9_pack

# Explicit target (not part of `all`): regenerate the tracked gen9_pack.h from Mesa genxml (needs third_party/mesa-25.2.8).
gen9_pack:
	python3 $(GENXML)/gen_pack_header.py --include-symbols "$(SYMBOLS)" $(GENXML)/gen90.xml > $(GEN9_PACK).tmp
	mv $(GEN9_PACK).tmp $(GEN9_PACK)

store.isa: store.cl extract.py
	ocloc compile -file store.cl -device whl -options "-cl-intel-greater-than-4GB-buffer-required" -output_no_suffix -output store >/dev/null
	python3 extract.py store.bin store $@

first: first.c $(GEN9_PACK)
	gcc -O2 -Wall -I../../lib/third_party/mesa -o $@ first.c
neo_compare: neo_compare.c
	gcc -O2 -Wall -o $@ $< -lOpenCL
probe: probe.c
	gcc -O2 -Wall -o $@ $<

kernels.h: store.cl kernels.py
	ocloc compile -file store.cl -device whl -options "-cl-intel-greater-than-4GB-buffer-required" -output_no_suffix -output store >/dev/null
	rm -rf dis && ocloc disasm -file store.bin -device whl -dump dis >/dev/null 2>&1
	python3 kernels.py store.bin dis/.ze_info > $@

chain: chain.c kernels.h gen9i.h $(GEN9_PACK)
	gcc -O2 -Wall -I../../lib/third_party/mesa -I. -o $@ chain.c
neo_chain: neo_chain.c
	gcc -O2 -Wall -o $@ $< -lOpenCL

# The same kernels with a binding table (default IGC mode: stateful pointers, 32-bit offsets)
kernels_bti.h: store.cl kernels.py
	ocloc compile -file store.cl -device whl -output_no_suffix -output store_bti >/dev/null
	rm -rf dis_bti && ocloc disasm -file store_bti.bin -device whl -dump dis_bti >/dev/null 2>&1
	python3 kernels.py store_bti.bin dis_bti/.ze_info > $@

chain_bti: chain.c kernels_bti.h gen9i.h $(GEN9_PACK)
	gcc -O2 -Wall -I../../lib/third_party/mesa -I. -DBTI -o $@ chain.c

# HGEMM: packing kernels from bench/hgemm.cl (IGC, binding table) and hgemm_v from bench/gen_h.bin (our assembler)
kernels_pack.h: ../../bench/hgemm.cl kernels.py
	ocloc compile -file ../../bench/hgemm.cl -device whl -output_no_suffix -output hgemm_cl >/dev/null
	rm -rf dis_h && ocloc disasm -file hgemm_cl.bin -device whl -dump dis_h >/dev/null 2>&1
	python3 kernels.py hgemm_cl.bin dis_h/.ze_info pk_a2_q,pk_bq_w2 > $@
kernels_gemm.h: ../../bench/gen_h.bin kernels.py
	rm -rf dis_gen && ocloc disasm -file ../../bench/gen_h.bin -device whl -dump dis_gen >/dev/null 2>&1
	python3 kernels.py ../../bench/gen_h.bin dis_gen/.ze_info hgemm_v > $@
gemm_h: gemm_h.c kernels_pack.h kernels_gemm.h gen9i.h $(GEN9_PACK)
	gcc -O2 -Wall -I../../lib/third_party/mesa -I. -o $@ gemm_h.c -lm

# userptr: cost of pinning pages versus copying, GPU reading process memory (docs/no-neo.md 6g); PHASES=1: split into phases
userptr: userptr.c kernels.h gen9i.h $(GEN9_PACK)
	gcc -O2 -Wall -I../../lib/third_party/mesa -I. -o $@ userptr.c
