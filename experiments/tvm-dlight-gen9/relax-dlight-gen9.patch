@@ -586,6 +586,18 @@ class LowBatchGEMV(GPUScheduleRule):
                     TS, TR = 4, 32
                 else:
                     TS, TR = 16, 32
+        elif target.kind.name in ("opencl", "vulkan") and "intel_gen9" in str(target.attrs):
+            # Intel Gen9: same row-stream constants as GEMV; each thread owns TILE_S = 2 rows x bucket
+            # batch accumulators (<= 8 floats per lane, well below the ~128 B/lane spill limit).
+            VEC_C = 4
+            LOAD_V_SHARED = False
+            LOAD_V_VEC = -1
+            UNROLL = 16
+            if isinstance(len_s, int):
+                if len_s > len_r:
+                    TS, TR = 2, 128
+                else:
+                    TS, TR = 4, 64
         elif target.kind.name == "opencl" and "mali" in str(target.attrs):
             VEC_C = 8
             LOAD_V_SHARED = False
diff --git a/python/tvm/s_tir/dlight/gpu/matmul.py b/python/tvm/s_tir/dlight/gpu/matmul.py
index 42299c2a1..5db466510 100644
--- a/python/tvm/s_tir/dlight/gpu/matmul.py
+++ b/python/tvm/s_tir/dlight/gpu/matmul.py
@@ -521,6 +521,27 @@ class Matmul(GPUScheduleRule):
                 storage_align=False,
                 inner_x=True,
             )
+        elif target.kind.name in ("opencl", "vulkan") and "intel_gen9" in str(target.attrs):
+            # Intel Gen9: 64 x 64 output tile per work-group (CLBlast's tuned MWG = NWG = 64 on the
+            # UHD 620), 16 x 8 = 128 threads, 4 x 8 = 32 FP32 accumulators per thread (128 B per lane:
+            # the largest private array IGC 24.35 keeps in registers), 16 B vector loads into shared
+            # memory (one 64 B line per SIMD-4 group of lanes), padded shared rows (stride-2 SLM reads
+            # run at about half speed). use_shared is a candidate: CLBlast picks no local memory on the
+            # UHD 620; sweep both.
+            return Matmul.Config(
+                block_size_x=16,
+                block_size_y=8,
+                vthread_x=1,
+                vthread_y=1,
+                micro_size_x=4,
+                micro_size_y=8,
+                micro_size_k=16,
+                vector_size=4,
+                unroll=64,
+                use_shared=True,
+                storage_align=True,
+                inner_x=False,
+            )
         else:
             return Matmul.Config()
 
